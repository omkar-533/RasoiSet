# Local API. Copy to .env only if you need to override defaults.
# Do not put live payment or provider secrets in the frontend.

PORT=5182
RASOISET_DB=data/rasoiset.sqlite
CORS_ORIGIN=http://localhost:5181

# Used only when the database is created for the first time.
# Change these before any shared or production use.
DEMO_OWNER_PASSWORD=RasoiSet-demo-1
DEMO_WAITER_PASSWORD=RasoiSet-demo-1
DEMO_OTHER_PASSWORD=RasoiSet-demo-1

# Password reset has no SMS sender. Leave SMS_API_URL unset.
# Locally the verification code is shown on the reset screen.
# NODE_ENV=production refuses reset and does not return a code.
# SMS_API_URL=

# UrbanPiper is the documented merchant route for Swiggy.
# Leave these unset until UrbanPiper issues them. Do not put the values in git.
# URBANPIPER_API_USERNAME=
# URBANPIPER_API_KEY=
# URBANPIPER_BIZ_ID=
# URBANPIPER_WEBHOOK_TOKEN=
# URBANPIPER_BASE_URL=https://pos-int.urbanpiper.com
# URBANPIPER_ALLOW_LIVE=1

# Zomato direct POS access is not approved for this installation.
# A token here only lets RasoiSet store an incoming webhook for investigation.
# It does not accept the order into the kitchen.
# ZOMATO_WEBHOOK_TOKEN=
